{
  "levelPackCreator": {
    "packs": {
      ".read": true,
      ".indexOn": ["updatedAt"],
      "$slug": {
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.child('owner').val() === auth.uid && newData.child('owner').val() === auth.uid))",
        ".validate": "$slug.matches(/^[a-z0-9][a-z0-9-]{0,69}$/) && newData.hasChildren(['owner','name','updatedAt'])",
        "owner": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "manifestPath": { ".validate": "newData.isString() && newData.val().beginsWith('levelPackCreator/' + auth.uid + '/' + $slug + '/packs/')" },
        "$other": { ".validate": false }
      }
    }
  }
}
